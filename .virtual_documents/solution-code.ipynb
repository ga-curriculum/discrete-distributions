


import numpy as np
import matplotlib.pyplot as plt
from scipy import stats





# Create a random variable X that represents the random variable of the number of Rowan voters sampled.
X = stats.binom(100, 0.6)





X.pmf(60)


X.cdf(60)


1 - X.cdf(69)


X.cdf(65) - X.cdf(54)





print(100*0.6)
print(X.mean())


print(100*0.6*0.4)
print(X.var())





xs = np.arange(101)

plt.figure(figsize=(6, 3))
plt.bar(xs, X.pmf(xs), color='navy');





Y = stats.binom(10, 0.6)
ys = np.arange(11)

plt.figure(figsize=(6, 3))
plt.bar(ys, Y.pmf(ys), color='navy');





M = stats.poisson(4)





np.random.seed(123)
matt_seltzers = M.rvs(20)


matt_seltzers





sum(matt_seltzers >= 6)





1 - M.cdf(5)





X = stats.poisson(5)





np.random.seed(123)
m100 = M.rvs(100)
x100 = X.rvs(100)


np.mean(m100 > x100)


np.mean(m100 + x100 > 12)


np.mean(
    12 - np.where(m100 + x100 > 12, 12, m100 + x100)
)



